{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prebench",
  "version": "0.2.3",
  "identifier": "dev.prebench.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Prebench",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Simulateur de cartes Nucleo et ESP32",
    "copyright": "© 2026 Mathis Rudkiewicz — MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/source/prebench.icon"
    ],
    "resources": {
      "../../libvmcu/": "sdk/libvmcu/",
      "../../boards/": "sdk/boards/",
      "../../components/": "sdk/components/",
      "../../templates/": "sdk/templates/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5RkEyRTkzNzExRTdENjgKUldSb2ZSNXhreTc2ZVNYZlQ2UkpuRisrU1Z5bzJTVU9iMHc4MDhXdHRjOGRkRzVIcjUvN3FOM0gK",
      "endpoints": [
        "https://github.com/rdkwcz08/prebench/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
