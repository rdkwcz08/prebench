{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Fenêtre principale : événements du cœur et liste fermée de commandes (section 11.4).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-default-project",
    "allow-open-project",
    "allow-start-simulation",
    "allow-stop-simulation",
    "allow-reset-simulation",
    "allow-component-control",
    "allow-check-prerequisites",
    "allow-list-templates",
    "allow-create-project",
    "allow-check-update",
    "allow-install-update"
  ]
}
